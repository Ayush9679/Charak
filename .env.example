# Frontend API routing. The committed mode files provide safe defaults:
# - .env.development: http://127.0.0.1:8000
# - .env.production:  /api (same-origin reverse proxy)
#
# To override a default, configure exactly one appropriate value per environment.
# Never set a localhost, 127.0.0.1, or public :8000 URL in production.
# VITE_API_BASE_URL=http://127.0.0.1:8000  # development only
# VITE_API_BASE_URL=/api                    # production only

# Backend: Groq LLM integration. Leave blank to use Charak's deterministic fallback locally.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Backend: comma-separated browser origins permitted to call the API.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Backend: use a persistent absolute path when deploying with SQLite, or a managed database URL.
DATABASE_URL=sqlite:///./chanakya.db

# Backend: verified hospital discovery configuration.
LOCAL_HOSPITAL_PROVIDER=osm
LOCAL_HOSPITAL_SEARCH_RADIUS_KM=10
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_DISCOVERY_CACHE_MINUTES=15

# Backend: protects the admin data-summary endpoint. Keep this server-only.
ADMIN_TOKEN=
